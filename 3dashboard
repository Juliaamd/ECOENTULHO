<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | EcoEntulho</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    min-height:100vh;
    background:
    linear-gradient(rgba(2,18,43,.92), rgba(2,18,43,.96)),
    url("img/background-ecoentulho.png");
    background-size:cover;
    background-position:center;
    color:white;
}

/* SIDEBAR */
.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:260px;
    height:100%;
    background:rgba(255,255,255,.05);
    backdrop-filter:blur(10px);
    border-right:1px solid rgba(255,255,255,.1);
    padding:30px 20px;
}

.logo{
    display:flex;
    justify-content:center;
    margin-bottom:40px;
}

.logo h1{
    font-size:1.8rem;
}

.logo span{
    color:#63d471;
}

.menu{
    display:flex;
    flex-direction:column;
    gap:15px;
}

.menu a{
    text-decoration:none;
    color:#e6e6e6;
    padding:12px;
    border-radius:10px;
    transition:.3s;
    font-weight:500;
}

.menu a:hover{
    background:#63d471;
    color:#02122B;
}

/* MAIN */
.main{
    margin-left:260px;
    padding:40px;
}

.header h2{
    font-size:2rem;
}

.header p{
    color:#cfcfcf;
    margin-bottom:25px;
}

/* CARDS */
.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:30px;
}

.card{
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.1);
    backdrop-filter:blur(10px);
    border-radius:20px;
    padding:20px;
}

.card h3{
    color:#63d471;
    margin-bottom:8px;
}

/* GRAFICO */
.grafico-container{
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.1);
    backdrop-filter:blur(10px);
    border-radius:20px;
    padding:20px;
}

/* RESPONSIVO */
@media(max-width:768px){
    .sidebar{ width:200px; }
    .main{ margin-left:200px; }
}

@media(max-width:600px){
    .sidebar{ display:none; }
    .main{ margin-left:0; }
}

</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

    <div class="logo">
        <h1><span>Eco</span>Entulho</h1>
    </div>

    <div class="menu">
        <a href="#" onclick="mostrarDashboard()">🏠 Dashboard</a>
        <a href="residuos.html">📦 Resíduos</a>
        <a href="#">🏗️ Obras</a>
        <a href="#">👤 Usuários</a>
        <a href="#" onclick="sair()">🚪 Sair</a>
    </div>

</div>

<!-- MAIN -->
<div class="main">

    <div class="header">
        <h2>Dashboard</h2>
        <p>Visão geral dos resíduos da construção civil</p>
    </div>

    <!-- CARDS -->
    <div class="cards">

        <div class="card">
            <h3>Total de Registros</h3>
            <p id="totalRegistros">0</p>
        </div>

        <div class="card">
            <h3>Total de Toneladas</h3>
            <p id="totalToneladas">0</p>
        </div>

        <div class="card">
            <h3>Tipos de Resíduos</h3>
            <p id="tipos">0</p>
        </div>

    </div>

    <!-- GRAFICO -->
    <div class="grafico-container">

        <h3 style="margin-bottom:15px; color:#63d471;">
            Resíduos por Tipo
        </h3>

        <canvas id="graficoResiduos"></canvas>

    </div>

</div>

<script>

// proteção login
if(localStorage.getItem("logado") !== "true"){
    window.location.href = "login.html";
}

function sair(){
    localStorage.removeItem("logado");
    window.location.href = "login.html";
}

function carregarDashboard(){

    const residuos = JSON.parse(localStorage.getItem("residuos")) || [];

    // métricas
    document.getElementById("totalRegistros").innerText = residuos.length;

    let totalTon = 0;
    let tipos = {};

    residuos.forEach(r => {
        totalTon += Number(r.quantidade);

        if(!tipos[r.tipo]){
            tipos[r.tipo] = 0;
        }
        tipos[r.tipo] += Number(r.quantidade);
    });

    document.getElementById("totalToneladas").innerText = totalTon;
    document.getElementById("tipos").innerText = Object.keys(tipos).length;

    // gráfico
    const labels = Object.keys(tipos);
    const data = Object.values(tipos);

    const ctx = document.getElementById("graficoResiduos");

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Toneladas',
                data: data,
                backgroundColor: '#63d471'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: { color: 'white' }
                }
            },
            scales: {
                x: { ticks: { color: 'white' } },
                y: { ticks: { color: 'white' } }
            }
        }
    });
}

carregarDashboard();

</script>

</body>
</html>
